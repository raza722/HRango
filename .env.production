# Production builds talk to the HRango API (mocks off).
# /api works when the app is served from the API's origin; to call an API elsewhere (it allows
# any origin), put its URL in .env.production.local (not committed):
#   VITE_API_BASE_URL=http://<api-server>:8000/api
VITE_API_BASE_URL=/api
VITE_API_TIMEOUT_MS=30000
VITE_ENABLE_MOCKS=false
VITE_MOCK_LATENCY_MS=0
VITE_ENABLE_DEVTOOLS=false
