# Copy to .env.local and adjust. Every key is optional; defaults live in src/lib/env.ts.
# Only variables prefixed with VITE_ are exposed to the browser bundle - never put secrets here.

# Product name shown in the browser tab and on the login screen.
VITE_APP_NAME="hRango"

# Base URL of the REST API. With mocks on, MSW answers requests under this path.
VITE_API_BASE_URL=/api

# Axios request timeout in milliseconds.
VITE_API_TIMEOUT_MS=15000

# true = start Mock Service Worker before rendering (no backend needed).
VITE_ENABLE_MOCKS=true

# Artificial latency for mocked responses, so loading states are visible.
VITE_MOCK_LATENCY_MS=400

# Show TanStack Query and Router devtools (development builds only).
VITE_ENABLE_DEVTOOLS=true
