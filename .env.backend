# Mode "backend": the real HRango API instead of the in-browser mocks.
#   npm run dev:api
# Vite proxies /api to VITE_DEV_API_TARGET, so the browser talks to one origin (no CORS).
# The default is a copy of the API on this machine. To use the team's dev server, put its
# address in .env.backend.local (not committed): VITE_DEV_API_TARGET=http://<dev-server>:8000
VITE_APP_NAME="hRango"
VITE_API_BASE_URL=/api
VITE_API_TIMEOUT_MS=30000
VITE_ENABLE_MOCKS=false
VITE_MOCK_LATENCY_MS=0
VITE_ENABLE_DEVTOOLS=true
VITE_DEV_API_TARGET=http://127.0.0.1:8000
